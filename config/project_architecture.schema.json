{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectArchitectureConfig",
  "description": "项目技术架构与技术栈配置文件 Schema 校验规范",
  "type": "object",
  "required": ["project", "tech_stack", "architecture_overview"],
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "initialized": { "type": "boolean", "description": "初始化完成标志：true 表示已由 auto_scan_stack.py 填充真实值" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "version", "app_type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "app_type": {
          "type": "string",
          "enum": ["frontend", "backend", "fullstack", "microservice", "cli", "library", "skill_package", "agent_skill"]
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "frameworks": {
          "type": "array",
          "description": "兼容历史老版本结构（扁平框架列表）",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        },
        "backend_frameworks": {
          "type": "array",
          "description": "后端/核心业务框架清单（如 FastAPI, Agno, Django, Gin 等）",
          "items": { "type": "string" }
        },
        "frontend_frameworks": {
          "type": "array",
          "description": "前端/用户界面框架与库（如 React, Vue, Next.js, Vanilla JS 等）",
          "items": { "type": "string" }
        },
        "testing": {
          "type": "object",
          "properties": {
            "framework": { "type": "string" },
            "min_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
            "testing_frameworks": { "type": "array", "items": { "type": "string" } }
          }
        },
        "databases_and_storage": {
          "type": "array",
          "description": "数据库与向量存储技术",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "security_and_sandbox": {
          "type": "array",
          "description": "数据安全脱敏与沙箱运行机制",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "purpose": { "type": "string" }
            }
          }
        },
        "expert_capabilities": {
          "type": "object",
          "description": "为各专家角色量身定制的专属技术能力列表",
          "properties": {
            "dev": { "type": "array", "items": { "type": "string" } },
            "frontend": { "type": "array", "items": { "type": "string" } },
            "reviewer": { "type": "array", "items": { "type": "string" } },
            "qa": { "type": "array", "items": { "type": "string" } },
            "architect": { "type": "array", "items": { "type": "string" } },
            "devops": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "architecture_overview": {
      "type": "object",
      "required": ["pattern", "core_directories"],
      "properties": {
        "pattern": { "type": "string" },
        "entry_points": { "type": "array", "items": { "type": "string" } },
        "core_directories": { "type": "object" }
      }
    },
    "deployment_and_ci": {
      "type": "object",
      "properties": {
        "containerized": { "type": "boolean" },
        "ci_cd_provider": { "type": "string" }
      }
    }
  }
}
